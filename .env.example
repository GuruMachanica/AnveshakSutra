# =============================================================================
# ANVESHAKSUTRA (अन्वेषकसूत्र) - MASTER UNIFIED ENVIRONMENT CONFIGURATION
# =============================================================================
# Template for Local Dev, Backend (Render), and Frontend (Vercel).
# =============================================================================

# ==========================================
# 1. BACKEND CONFIGURATION (Add to Render)
# ==========================================
ENVIRONMENT=production
PROJECT_NAME="AnveshakSutra API"
VERSION="1.0.0"
API_V1_STR="/api/v1"
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","https://anveshaksutra.vercel.app","https://anveshaksutra.netlify.app"]

# --- Security & JWT ---
JWT_SECRET_KEY=generate_a_random_32_or_64_byte_secret_key_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- WebAuthn / Passkeys ---
RP_ID=localhost
RP_NAME=AnveshakSutra
RP_ORIGIN=http://localhost:3000

# --- Supabase PostgreSQL Database ---
# Replace [REF], [PASSWORD], and [REGION] with your Supabase credentials:
DATABASE_URL=postgresql+asyncpg://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
SUPABASE_KEY=your_supabase_anon_public_key_here
SUPABASE_PUBLISHABLE_KEY=your_supabase_anon_public_key_here
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_here
SUPABASE_JWKS_URL=https://[YOUR_PROJECT_REF].supabase.co/auth/v1/.well-known/jwks.json

# --- External Verification APIs ---
GITHUB_API_URL=https://api.github.com/user
OPENAI_API_URL=https://api.openai.com/v1/models

# --- Zero-Cost Async Engine ---
ASYNC_ENGINE_WORKERS=4
IN_MEMORY_CACHE_TTL=3600

# ==========================================
# 2. FRONTEND CONFIGURATION (Add to Vercel)
# ==========================================
VITE_API_URL=https://anveshaksutra.onrender.com/api/v1
VITE_SUPABASE_URL=https://[YOUR_PROJECT_REF].supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here
